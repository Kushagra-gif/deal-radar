# Paste your TinyFish API key after the = sign, save the file, then run: streamlit run app.py
# Create a key at https://agent.tinyfish.ai/api-keys  (it is shown only once, so copy it right away)
TINYFISH_API_KEY=PASTE_YOUR_TINYFISH_API_KEY_HERE

# Optional safety settings
# MAX_RUNS_PER_SESSION=40
# APP_PASSWORD=choose-a-password-if-you-deploy-publicly
